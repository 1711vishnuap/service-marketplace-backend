# ==========================================
# SERVER
# ==========================================
PORT=5000
NODE_ENV=development

# ==========================================
# DATABASE (MySQL)
# ==========================================
DB_HOST=mysql-13338be0-fixy-app.e.aivencloud.com
DB_PORT=21316
DB_USER=avnadmin
DB_PASSWORD=AVNS_8XPQ0AoxP3nGhaXVhFu
DB_NAME=service_marketplace

# ==========================================
# JWT (used for session tokens after OTP login)
# ==========================================
JWT_SECRET=replace_this_with_a_long_random_secret_string
JWT_EXPIRES_IN=30d

# ==========================================
# FIREBASE (used ONLY for sending push notifications via FCM)
# Download this file from Firebase Console > Project Settings >
# Service Accounts > Generate New Private Key, and place it in
# the backend root folder (never commit it to git).
# ==========================================
FIREBASE_SERVICE_ACCOUNT_PATH=./firebase-service-account.json

# ==========================================
# OTP SETTINGS
# For this MVP, OTPs are generated and checked by our own backend
# (no external SMS gateway wired up yet). In development, the OTP
# is printed to the server console and also returned in the API
# response so you can test without a real SMS provider.
# ==========================================
OTP_EXPIRY_MINUTES=5

# ==========================================
# NEAREST WORKER MATCHING
# ==========================================
NEARBY_RADIUS_KM=15
NEARBY_WORKERS_LIMIT=5
